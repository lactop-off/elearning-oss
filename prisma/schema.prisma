// Prisma schema for E-learning OSS
// Domain model derived from CLAUDE.md
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────

enum UserRole {
  LEARNER
  INSTRUCTOR
  ADMIN
}

enum LessonContentType {
  TEXT
  VIDEO
  EMBED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTI_CHOICE
  TEXT
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  ABANDONED
}

// ─── Users ──────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String?
  role          UserRole  @default(LEARNER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  coursesAuthored Course[]      @relation("CourseInstructor")
  enrollments     Enrollment[]
  attempts        Attempt[]
  certificates    Certificate[]

  @@index([role])
}

// ─── Courses & Lessons ──────────────────────────────────────────────

model Course {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  description  String?
  instructorId String
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  instructor   User          @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: Restrict)
  lessons      Lesson[]
  enrollments  Enrollment[]
  quizzes      Quiz[]        @relation("CourseQuiz")
  certificates Certificate[]

  @@index([instructorId])
  @@index([publishedAt])
}

model Lesson {
  id          String            @id @default(cuid())
  courseId    String
  title       String
  order       Int
  contentType LessonContentType @default(TEXT)
  content     String            @default("")
  isRequired  Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  course   Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quizzes  Quiz[]     @relation("LessonQuiz")
  progress Progress[]

  @@unique([courseId, order])
  @@index([courseId])
}

// ─── Enrollment & Progress ──────────────────────────────────────────

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress Progress[]

  @@unique([userId, courseId])
  @@index([courseId])
}

model Progress {
  id           String   @id @default(cuid())
  enrollmentId String
  lessonId     String
  completedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([lessonId])
}

// ─── Quizzes ────────────────────────────────────────────────────────

model Quiz {
  id             String   @id @default(cuid())
  lessonId       String?
  courseId       String?
  title          String
  description    String?
  passingScore   Int      @default(70) // percentage
  timeLimitSec   Int?
  maxAttempts    Int?
  isRequired     Boolean  @default(true)
  shuffleChoices Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lesson    Lesson?    @relation("LessonQuiz", fields: [lessonId], references: [id], onDelete: Cascade)
  course    Course?    @relation("CourseQuiz", fields: [courseId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  Attempt[]

  @@index([lessonId])
  @@index([courseId])
}

model Question {
  id        String       @id @default(cuid())
  quizId    String
  type      QuestionType
  body      String
  order     Int
  points    Int          @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  choices Choice[]
  answers Answer[]

  @@unique([quizId, order])
  @@index([quizId])
}

model Choice {
  id         String   @id @default(cuid())
  questionId String
  body       String
  isCorrect  Boolean  @default(false)
  order      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedAnswers Answer[] @relation("AnswerChoices")

  @@unique([questionId, order])
  @@index([questionId])
}

// ─── Attempts & Answers ─────────────────────────────────────────────

model Attempt {
  id          String        @id @default(cuid())
  userId      String
  quizId      String
  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  submittedAt DateTime?
  score       Int? // percentage 0-100
  passed      Boolean?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([userId, quizId])
  @@index([quizId])
}

model Answer {
  id            String   @id @default(cuid())
  attemptId     String
  questionId    String
  textAnswer    String?
  isCorrect     Boolean?
  pointsAwarded Int?     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  attempt         Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question        Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedChoices Choice[] @relation("AnswerChoices")

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// ─── Certificates ───────────────────────────────────────────────────

model Certificate {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  issuedAt  DateTime @default(now())
  serial    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}
